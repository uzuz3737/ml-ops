# Local classroom services only; public deployment needs separate configuration.
AIRFLOW_UID=50000
APP_UID=1000
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=airflow-local-demo
AIRFLOW_ADMIN_EMAIL=local@example.invalid
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow-local-demo
POSTGRES_DB=airflow
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana-local-demo
MLFLOW_TRACKING_URI=http://mlflow:5000
PIPELINE_WORKER_URL=http://pipeline-worker:8100
MLOPS_STEP_TIMEOUT_SECONDS=1910
AIRFLOW_URL=http://airflow-webserver:8080
API_URL=http://api:8000
# Hash-locked dependency sets: worker = P1 + P2 + benchmark, API = serving.
WORKER_REQUIREMENTS=requirements/worker.lock
API_REQUIREMENTS=requirements/serving.lock
